# Server-side only. Copy this file to .env.local and add the value there.
# Never commit a real key or prefix this variable with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Live Earth Engine spatial computation. Register the Cloud project for the
# appropriate commercial/non-commercial tier and keep these server-side.
EARTH_ENGINE_PROJECT_ID=
EARTH_ENGINE_SERVICE_ACCOUNT_EMAIL=
# Preserve PEM newlines as literal \n sequences in single-line environments.
EARTH_ENGINE_PRIVATE_KEY=
SPATIAL_TILE_SECRET=

# Administrator credentials are server-side only. Use a strong unique password
# and a random session secret of at least 32 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Netlify Database injects this automatically in deploys and deploy previews.
# Set it only when running the standard Next.js server outside Netlify.
NETLIFY_DB_URL=

# Screen 03 durable workflow identity and capability-scoped integrations.
# Register the exact production and preview callback URLs in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Random values of at least 32 characters. Encryption keys must decode to 32 bytes.
WORKFLOW_SESSION_SECRET=
WORKFLOW_DATA_ENCRYPTION_KEY=
OAUTH_TOKEN_ENCRYPTION_KEY=

# Required on Netlify Starter teams after enabling the Async Workloads extension.
# Other Netlify plans may provision this automatically at team level.
NETLIFY_ASYNC_WORKLOADS_API_KEY=
