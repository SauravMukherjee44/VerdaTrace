# Server-side only. Copy this file to .env.local and add the value there.
# Never commit a real key or prefix this variable with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Administrator credentials are server-side only. Use a strong unique password
# and a random session secret of at least 32 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Netlify Database injects this automatically in deploys and deploy previews.
# Set it only when running the standard Next.js server outside Netlify.
NETLIFY_DB_URL=
